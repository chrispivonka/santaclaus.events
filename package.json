{
  "name": "santaclaus-events",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "vp check",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:html": "html-validate index.html 404.html",
    "lint": "vp lint && bun run lint:css && bun run lint:html",
    "fmt": "vp fmt",
    "verify:dist": "node scripts/check.js",
    "test": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "images": "node scripts/images.js",
    "fonts": "node scripts/fonts.js",
    "prepare": "vp config --hooks --no-agent"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "html-validate": "^11.16.2",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "subset-font": "^2.9.0",
    "vite-plus": "1.4.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2"
}

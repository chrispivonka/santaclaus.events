{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "errors-in-console": "error",
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500,
            "aggregationMethod": "median-run"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 150
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 40000
          }
        ],
        "resource-summary:font:size": [
          "error",
          {
            "maxNumericValue": 120000
          }
        ],
        "resource-summary:image:size": [
          "error",
          {
            "maxNumericValue": 200000
          }
        ],
        "resource-summary:document:size": [
          "error",
          {
            "maxNumericValue": 30000
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 350000
          }
        ],
        "resource-summary:third-party:count": [
          "error",
          {
            "maxNumericValue": 0
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
